# ──────────────────────────────────────────────
# Omni2API Server — Environment Configuration
# Copy to .env and adjust values
# ──────────────────────────────────────────────

# Server
OMNI2API_HOST=0.0.0.0
OMNI2API_PORT=8080
OMNI2API_BACKEND=memory # or: postgres

# PostgreSQL (only when OMNI2API_BACKEND=postgres)
DATABASE_URL=postgres://omni2api:omni2api@localhost:5432/omni2api

# Backpressure
OMNI2API_MAX_BODY_BYTES=8388608
OMNI2API_MAX_CONCURRENCY=256

# Reply behavior
OMNI2API_REPLY_TIMEOUT_SECS=300
OMNI2API_MERGE_WINDOW_MS=2000
OMNI2API_KEEPALIVE_SECS=5
OMNI2API_ASYNC_MODE= # set to "always" to never block on a human
OMNI2API_MOCK_ENDPOINTS= # set to "1" to enable /v1/mock/* (dev/test only)

# Presence notices streamed before the human answers
OMNI2API_ACK_ONLINE= # set to "0" to skip the online notice
OMNI2API_ONLINE_MESSAGE=
OMNI2API_OFFLINE_MESSAGE=
OMNI2API_ONLINE_NOTICE=

# Offline push
FIREBASE_KEY_PATH=/app/firebase-key.json
DEFAULT_FCM_DEVICE_TOKEN=
NOTIFICATION_WEBHOOK_URL=
SERVER_PUBLIC_URL=

# Logging
RUST_LOG=omni2api_server=info,tower_http=info
